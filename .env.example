# FlowBridge Environment Configuration
# =====================================================================
# NOTE: The system is 100% functional out-of-the-box with ZERO API KEYS!
# All external services (Open-Meteo, Local Synthetic SCADA Telemetry)
# operate automatically with seamless fallbacks.
# =====================================================================

# 1. Weather API (Optional - Open-Meteo is free and works without any key)
OPENMETEO_API_KEY=
OPENWEATHER_API_KEY=

# 2. Geospatial Mapbox Token (Optional - default uses CartoDB Dark Matter)
MAPBOX_ACCESS_TOKEN=

# 3. Kaggle API Credentials (Optional - for direct Kaggle dataset sync)
KAGGLE_USERNAME=
KAGGLE_KEY=

# 4. Municipal SCADA Simulation Settings
MUNICIPAL_DISTRICT_NAME="Neo-Veridia Metropolitan Water Authority"
CITY_LATITUDE=12.9716
CITY_LONGITUDE=77.5946
RESERVOIR_TOTAL_CAPACITY_ML=120.0
